# ─────────────────────────────────────────────────────────────────
#  Lexume – Backend Environment Variables
#  Copy this file to .env inside the backend/ folder and fill in
#  your secrets.  Never commit the actual .env file.
# ─────────────────────────────────────────────────────────────────

# ── AI APIs ───────────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs TTS — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID to use by default (George). Browse: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── Google OAuth 2.0 (login + Drive) ─────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/auth/drive/callback

# ── Security ──────────────────────────────────────────────────────
# Secret key for signing JWTs — use a long random string in production
JWT_SECRET=change_me_to_a_random_secret_string
# Secret used to encrypt stored Drive tokens
ENCRYPTION_SECRET=change_me_to_another_random_secret

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API
# Production example: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Credits / Pricing (optional overrides) ───────────────────────
# These have sensible defaults; only set them to override
# CREDIT_STARTER_BALANCE=100
# CREDIT_COST_EXTRACTION=1
# CREDIT_COST_AUDIO_MIN=2
# CREDIT_COST_AUDIO_PER_K_CHARS=1
# CREDIT_COST_TRANSLATION=1
# GEMINI_INPUT_PRICE_PER_M_TOKENS=0.075
# GEMINI_OUTPUT_PRICE_PER_M_TOKENS=0.30
# ELEVENLABS_PRICE_PER_K_CHARS=0.18

# ── Admin ─────────────────────────────────────────────────────────
# Optional key for admin-only API endpoints
# ADMIN_API_KEY=your_admin_key_here

# ── Lexume Plus subscription ─────────────────────────────────────
# See backend/api/routes/billing.py + backend/api/subscription.py, and the
# subscription plan doc for the business rationale behind these defaults.
# SUBSCRIPTION_PAGES_QUOTA=70
# SUBSCRIPTION_PRICE_MONTHLY_USD=12.99
# SUBSCRIPTION_PRICE_ANNUAL_USD=99.99

# Stripe — https://dashboard.stripe.com/apikeys (web / Mac direct-distribution path)
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_ANNUAL=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://your-app.vercel.app/billing/success
# STRIPE_CHECKOUT_CANCEL_URL=https://your-app.vercel.app/billing/cancel
# STRIPE_PORTAL_RETURN_URL=https://your-app.vercel.app/settings

# Google Play Billing — a service account with Android Publisher API access
# (Play Console → Setup → API access), used to verify purchases server-side.
# PLAY_PACKAGE_NAME=com.aboooooo57.lexume
# PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # inline JSON, not a file path
# PLAY_RTDN_WEBHOOK_SECRET=change_me_to_a_random_secret_string
